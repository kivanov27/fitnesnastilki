generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model product {
  id                       Int           @id(map: "Product_pkey") @default(autoincrement())
  name                     String        @db.VarChar(255)
  price                    Float
  discount                 Float?
  link                     String        @unique @db.VarChar(255)
  image1                   String?       @db.VarChar(255)
  image2                   String?       @db.VarChar(255)
  image3                   String?       @db.VarChar(255)
  image4                   String?       @db.VarChar(255)
  category                 String[]      @db.VarChar(20)
  popular                  Boolean?      @default(false)
  description              String?
  manufacturer             String?       @db.VarChar(25)
  manufacturer_description String?
  order_items              order_items[]
}

model categories {
  name    String?  @db.VarChar(50)
  image   String?  @db.VarChar(255)
  link    String?  @db.VarChar(50)
  popular Boolean? @default(false)
  id      Int      @id @default(autoincrement())
}

model slider {
  text  String? @db.VarChar(255)
  image String? @db.VarChar(255)
  id    Int     @id @default(autoincrement())
}

model orders {
  id               String        @id @default(uuid()) @db.VarChar(36)
  customer_name    String        @db.VarChar(25)
  customer_surname String        @db.VarChar(25)
  customer_email   String        @db.VarChar(255)
  customer_phone   String        @db.VarChar(20)
  customer_address String        @db.VarChar(255)
  total_price      Decimal       @db.Decimal(10, 2)
  status           String?       @default("Pending") @db.VarChar(20)
  created_at       DateTime?     @default(now()) @db.Timestamp(6)
  customer_city    String        @db.VarChar(255)
  notes            String?
  order_items      order_items[]
}

model order_items {
  id           String  @id @default(uuid()) @db.VarChar(36)
  order_id     String  @db.VarChar(36)
  product_name String  @db.VarChar(255)
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)
  product_id   Int
  orders       orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user {
  id        String  @id @default(uuid())
  password  String  @db.VarChar(100)
  email     String  @unique @db.VarChar(255)
  phone     String  @db.VarChar(20)
  address   String  @db.VarChar(255)
  firstName String? @db.VarChar(25)
  lastName  String? @db.VarChar(25)
  city      String  @db.VarChar(20)
}

model logo {
  image String @db.VarChar(255)
  link  String @db.VarChar(50)
  id    Int    @id @default(autoincrement())
}
