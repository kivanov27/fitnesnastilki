generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model product {
    id                       Int           @id(map: "Product_pkey") @default(autoincrement())
    name                     String        @db.VarChar(255)
    price                    Float
    discount                 Float?
    link                     String        @unique @db.VarChar(255)
    image1                   String?       @db.VarChar(255)
    image2                   String?       @db.VarChar(255)
    image3                   String?       @db.VarChar(255)
    image4                   String?       @db.VarChar(255)
    image5                   String?       @db.VarChar(255)
    image6                   String?       @db.VarChar(255)
    image7                   String?       @db.VarChar(255)
    image8                   String?       @db.VarChar(255)
    category                 String[]      @db.VarChar(20)
    popular                  Boolean?      @default(false)
    description              String?
    manufacturer             String?       @db.VarChar(25)
    manufacturer_description String?
    order_items              order_items[]
    cartItems                cartItem[]
}

model categories {
    id      Int      @id @default(autoincrement())
    name    String?  @db.VarChar(50)
    image   String?  @db.VarChar(255)
    link    String?  @db.VarChar(50)
    popular Boolean? @default(false)
}

model slider {
    id    Int     @id @default(autoincrement())
    text  String? @db.VarChar(255)
    image String? @db.VarChar(255)
}

model orders {
    id               String        @id @default(uuid()) @db.VarChar(36)
    customer_name    String        @db.VarChar(25)
    customer_surname String        @db.VarChar(25)
    customer_email   String        @db.VarChar(255)
    customer_phone   String        @db.VarChar(20)
    customer_address String        @db.VarChar(255)
    customer_city    String        @db.VarChar(255)
    total_price      Decimal       @db.Decimal(10, 2)
    status           String?       @default("Очаква се") @db.VarChar(20)
    created_at       DateTime?     @default(now()) @db.Timestamp(6)
    notes            String?
    order_items      order_items[]
}

model order_items {
    id           String  @id @default(uuid()) @db.VarChar(36)
    order_id     String  @db.VarChar(36)
    product_name String  @db.VarChar(255)
    price        Decimal @db.Decimal(10, 2)
    quantity     Int
    subtotal     Decimal @db.Decimal(10, 2)
    product_id   Int
    orders       orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
    product      product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user {
    id        String  @id @default(uuid())
    password  String  @db.VarChar(100)
    email     String  @unique @db.VarChar(255)
    phone     String  @db.VarChar(20)
    address   String  @db.VarChar(255)
    firstName String? @db.VarChar(25)
    lastName  String? @db.VarChar(25)
    city      String  @db.VarChar(20)
    cartItems cartItem[]
}

model logo {
    id    Int    @id @default(autoincrement())
    image String @db.VarChar(255)
    link  String @db.VarChar(50)
}

model cartItem {
    id          Int     @id @default(autoincrement())
    user        user    @relation(fields: [userId], references: [id])
    userId      String
    product     product @relation(fields: [productId], references: [id])
    productId   Int
    quantity    Int

    @@unique([userId, productId]) // Prevent duplicates per user
}
